# ─────────────────────────────────────────────
# CodeBlue 환경변수 예시 파일
# 실제 값은 .env.local에 작성하고 절대 커밋하지 않는다.
# ─────────────────────────────────────────────

# 사이트 기본 URL (SEO_PLAN.md metadataBase, sitemap/robots에서 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 문의 폼 이메일 발송 (Phase 11B: Contact Production Readiness) ───────────
# Supabase는 더 이상 이 프로젝트에서 사용하지 않는다(2026-08-17) — 문의는 저장 없이
# 아래 Resend 설정으로 CONTACT_NOTIFICATION_EMAIL에 바로 이메일로만 전달된다.
RESEND_API_KEY=
# Resend에 검증된 발신 도메인의 주소여야 한다 (예: notify@yourdomain.com)
RESEND_FROM_EMAIL=
# 새 문의를 받을 관리자 실제 이메일 주소
CONTACT_NOTIFICATION_EMAIL=

# ── 문의 Telegram 알림 (2026-08-19: 이메일 발송 성공 시 추가로 보내는 최소 알림) ──────
# 서버 전용 값이다 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다. 둘 중 하나라도 비어 있으면
# 이메일 발송은 정상 작동하고 Telegram 알림만 건너뛴다(서버 로그에 경고 1회 기록).
# 발급 방법은 README/운영 문서 또는 최종 작업 보고를 참고한다(@BotFather로 봇 생성 →
# 토큰 발급, 본인 채팅방에서 Chat ID 확인).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 분석/이벤트 트래킹 (Phase 13: SEO — PRD.md 6.4) ─────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity 프로젝트 ID (clarity.ms 대시보드 → Settings → Setup)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
